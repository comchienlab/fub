# Simple update function
update_fub() {
    # Check if installed via Homebrew
    if command -v brew > /dev/null 2>&1 && brew list fub > /dev/null 2>&1; then
        update_via_homebrew "$VERSION"
        exit 0
    fi

    # Check for updates
    local latest
    latest=$(get_latest_version)

    if [[ -z "$latest" ]]; then
        log_error "Unable to check for updates. Check network connection."
        exit 1
    fi

    if [[ "$VERSION" == "$latest" ]]; then
        echo ""
        echo -e "${GREEN}${ICON_SUCCESS}${NC} Already on latest version (${VERSION})"
        echo ""
        exit 0
    fi

    # Download and run installer with progress
    if [[ -t 1 ]]; then
        start_inline_spinner "Downloading latest version..."
    else
        echo "Downloading latest version..."
    fi

    local installer_url="https://raw.githubusercontent.com/tw93/fub/main/install.sh"
    local tmp_installer
    tmp_installer="$(mktemp_file)" || {
        log_error "Update failed"
        exit 1
    }

    # Download installer with progress
    if command -v curl > /dev/null 2>&1; then
        if ! curl -fsSL --connect-timeout 10 --max-time 60 "$installer_url" -o "$tmp_installer" 2>&1; then
            if [[ -t 1 ]]; then stop_inline_spinner; fi
            rm -f "$tmp_installer"
            log_error "Update failed. Check network connection."
            exit 1
        fi
    elif command -v wget > /dev/null 2>&1; then
        if ! wget --timeout=10 --tries=3 -qO "$tmp_installer" "$installer_url" 2>&1; then
            if [[ -t 1 ]]; then stop_inline_spinner; fi
            rm -f "$tmp_installer"
            log_error "Update failed. Check network connection."
            exit 1
        fi
    else
        if [[ -t 1 ]]; then stop_inline_spinner; fi
        rm -f "$tmp_installer"
        log_error "curl or wget required"
        exit 1
    fi

    if [[ -t 1 ]]; then stop_inline_spinner; fi
    chmod +x "$tmp_installer"

    # Determine install directory
    local fub_path
    fub_path="$(command -v fub 2> /dev/null || echo "$0")"
    local install_dir
    install_dir="$(cd "$(dirname "$fub_path")" && pwd)"

    if [[ -t 1 ]]; then
        start_inline_spinner "Installing update..."
    else
        echo "Installing update..."
    fi

    # Helper function to process installer output
    process_install_output() {
        local output="$1"
        if [[ -t 1 ]]; then stop_inline_spinner; fi

        local filtered_output
        filtered_output=$(printf '%s\n' "$output" | sed '/^$/d')
        if [[ -n "$filtered_output" ]]; then
            printf '\n%s\n' "$filtered_output"
        fi

        # Only show success message if installer didn't already do so
        if ! printf '%s\n' "$output" | grep -Eq "Updated to latest version|Already on latest version"; then
            local new_version
            new_version=$("$fub_path" --version 2> /dev/null | awk 'NF {print $NF}' || echo "")
            printf '\n%s\n\n' "${GREEN}${ICON_SUCCESS}${NC} Updated to latest version (${new_version:-unknown})"
        else
            printf '\n'
        fi
    }

    # Run installer with visible output (but capture for error handling)
    local install_output
    if install_output=$("$tmp_installer" --prefix "$install_dir" --config "$HOME/.config/fub" --update 2>&1); then
        process_install_output "$install_output"
    else
        # Retry without --update flag
        if install_output=$("$tmp_installer" --prefix "$install_dir" --config "$HOME/.config/fub" 2>&1); then
            process_install_output "$install_output"
        else
            if [[ -t 1 ]]; then stop_inline_spinner; fi
            rm -f "$tmp_installer"
            log_error "Update failed"
            echo "$install_output" | tail -10 >&2 # Show last 10 lines of error
            exit 1
        fi
    fi

    rm -f "$tmp_installer"
    rm -f "$HOME/.cache/fub/version_check" "$HOME/.cache/fub/update_message"
}

# Remove Fub from system
remove_fub() {
    # Detect all installations with loading
    if [[ -t 1 ]]; then
        start_inline_spinner "Detecting Fub installations..."
    else
        echo "Detecting installations..."
    fi

    local is_homebrew=false
    local -a manual_installs=()
    local -a alias_installs=()

    # Check Homebrew
    if command -v brew > /dev/null 2>&1 && brew list fub > /dev/null 2>&1; then
        is_homebrew=true
    fi

    # Find fub installations using which/command
    local found_fub
    found_fub=$(command -v fub 2> /dev/null || true)
    if [[ -n "$found_fub" && -f "$found_fub" ]]; then
        # Check if it's not a Homebrew symlink
        if [[ ! -L "$found_fub" ]] || ! readlink "$found_fub" | grep -q "Cellar/fub"; then
            manual_installs+=("$found_fub")
        fi
    fi

    # Also check common locations as fallback
    local -a fallback_paths=(
        "/usr/local/bin/fub"
        "$HOME/.local/bin/fub"
        "/opt/local/bin/fub"
    )

    for path in "${fallback_paths[@]}"; do
        if [[ -f "$path" && "$path" != "$found_fub" ]]; then
            # Check if it's not a Homebrew symlink
            if [[ ! -L "$path" ]] || ! readlink "$path" | grep -q "Cellar/fub"; then
                manual_installs+=("$path")
            fi
        fi
    done

    # Find fb alias
    local found_fb
    found_fb=$(command -v fb 2> /dev/null || true)
    if [[ -n "$found_fb" && -f "$found_fb" ]]; then
        alias_installs+=("$found_fb")
    fi

    # Also check common locations for fb
    local -a alias_fallback=(
        "/usr/local/bin/fb"
        "$HOME/.local/bin/fb"
        "/opt/local/bin/fb"
    )

    for alias in "${alias_fallback[@]}"; do
        if [[ -f "$alias" && "$alias" != "$found_fb" ]]; then
            alias_installs+=("$alias")
        fi
    done

    if [[ -t 1 ]]; then
        stop_inline_spinner
    fi

    printf '\n'

    # Check if anything to remove
    local manual_count=${#manual_installs[@]}
    local alias_count=${#alias_installs[@]}
    if [[ "$is_homebrew" == "false" && ${manual_count:-0} -eq 0 && ${alias_count:-0} -eq 0 ]]; then
        printf '%s\n\n' "${YELLOW}No Fub installation detected${NC}"
        exit 0
    fi

    # Show what will be removed
    echo -e "${YELLOW}Remove Fub${NC} - will delete the following:"
    if [[ "$is_homebrew" == "true" ]]; then
        echo "  - Fub via Homebrew"
    fi
    for install in ${manual_installs[@]+"${manual_installs[@]}"} ${alias_installs[@]+"${alias_installs[@]}"}; do
        echo "  - $install"
    done
    echo "  - ~/.config/fub"
    echo "  - ~/.cache/fub"
    echo -ne "${PURPLE}${ICON_ARROW}${NC} Press ${GREEN}Enter${NC} to confirm, ${GRAY}ESC${NC} to cancel: "

    # Read single key
    IFS= read -r -s -n1 key || key=""
    drain_pending_input # Clean up any escape sequence remnants
    case "$key" in
        $'\e')
            echo -e "${GRAY}Cancelled${NC}"
            echo ""
            exit 0
            ;;
        "" | $'\n' | $'\r')
            printf "\r\033[K" # Clear the prompt line
            # Continue with removal
            ;;
        *)
            echo -e "${GRAY}Cancelled${NC}"
            echo ""
            exit 0
            ;;
    esac

    # Remove Homebrew installation (silent)
    local has_error=false
    if [[ "$is_homebrew" == "true" ]]; then
        if ! brew uninstall fub > /dev/null 2>&1; then
            has_error=true
        fi
    fi
    # Remove manual installations
    if [[ ${manual_count:-0} -gt 0 ]]; then
        for install in "${manual_installs[@]}"; do
            if [[ -f "$install" ]]; then
                # Check if directory requires sudo (deletion is a directory operation)
                if [[ ! -w "$(dirname "$install")" ]]; then
                    # Requires sudo
                    if ! sudo rm -f "$install" 2> /dev/null; then
                        has_error=true
                    fi
                else
                    # Regular user permission
                    if ! rm -f "$install" 2> /dev/null; then
                        has_error=true
                    fi
                fi
            fi
        done
    fi
    if [[ ${alias_count:-0} -gt 0 ]]; then
        for alias in "${alias_installs[@]}"; do
            if [[ -f "$alias" ]]; then
                # Check if directory requires sudo
                if [[ ! -w "$(dirname "$alias")" ]]; then
                    sudo rm -f "$alias" 2> /dev/null || true
                else
                    rm -f "$alias" 2> /dev/null || true
                fi
            fi
        done
    fi
    # Clean up cache first (silent)
    if [[ -d "$HOME/.cache/fub" ]]; then
        rm -rf "$HOME/.cache/fub" 2> /dev/null || true
    fi
    # Clean up configuration last (silent)
    if [[ -d "$HOME/.config/fub" ]]; then
        rm -rf "$HOME/.config/fub" 2> /dev/null || true
    fi

    # Show final result
    local final_message
    if [[ "$has_error" == "true" ]]; then
        final_message="${YELLOW}${ICON_ERROR} Fub uninstalled with some errors, thank you for using Fub!${NC}"
    else
        final_message="${GREEN}${ICON_SUCCESS} Fub uninstalled successfully, thank you for using Fub!${NC}"
    fi
    printf '\n%s\n\n' "$final_message"

    exit 0
}

# Display main menu options with minimal refresh to avoid flicker
show_main_menu() {
    local selected="${1:-1}"
    local _full_draw="${2:-true}" # Kept for compatibility (unused)
    local banner="${MAIN_MENU_BANNER:-}"
    local update_message="${MAIN_MENU_UPDATE_MESSAGE:-}"

    # Fallback if globals missing (should not happen)
    if [[ -z "$banner" ]]; then
        banner="$(show_brand_banner)"
        MAIN_MENU_BANNER="$banner"
    fi

    printf '\033[H' # Move cursor to home

    local line=""
    # Leading spacer
    printf '\r\033[2K\n'

    # Brand banner
    while IFS= read -r line || [[ -n "$line" ]]; do
        printf '\r\033[2K%s\n' "$line"
    done <<< "$banner"

    # Update notification block (if present)
    if [[ -n "$update_message" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            printf '\r\033[2K%s\n' "$line"
        done <<< "$update_message"
    fi

    # Spacer before menu options
    printf '\r\033[2K\n'

    printf '\r\033[2K%s\n' "$(show_menu_option 1 "System Status - Real-time health dashboard" "$([[ $selected -eq 1 ]] && echo true || echo false)")"
    printf '\r\033[2K%s\n' "$(show_menu_option 2 "Clean System - Remove junk files and optimize" "$([[ $selected -eq 2 ]] && echo true || echo false)")"
    printf '\r\033[2K%s\n' "$(show_menu_option 3 "Uninstall Apps - Remove applications completely" "$([[ $selected -eq 3 ]] && echo true || echo false)")"
    printf '\r\033[2K%s\n' "$(show_menu_option 4 "Optimize System - System health & tuning" "$([[ $selected -eq 4 ]] && echo true || echo false)")"
    printf '\r\033[2K%s\n' "$(show_menu_option 5 "More Tools - Additional utilities & setup" "$([[ $selected -eq 5 ]] && echo true || echo false)")"

    if [[ -t 0 ]]; then
        printf '\r\033[2K\n'
        printf '\r\033[2K%s\n' "${GRAY}↑/↓ Nav  ${GRAY}|${NC}  ${GRAY}Enter${NC} Select  ${GRAY}|${NC}  ${GRAY}H${NC} Help  ${GRAY}|${NC}  ${GRAY}Q${NC} Quit"
        printf '\r\033[2K\n'
    fi

    # Clear any remaining content below without full screen wipe
    printf '\033[J'
}

# More Tools sub-menu
show_more_tools_menu() {
    local current_option=1
    local first_draw=true

    cleanup_and_exit_submenu() {
        show_cursor
        # Return to main menu
        exec "$0"
    }

    trap cleanup_and_exit_submenu INT
    hide_cursor

    while true; do
        # Draw sub-menu
        printf '\033[H' # Move cursor to home
        printf '\r\033[2K\n'

        # Banner
        printf '\r\033[2K%s\n' "${GREEN}╔═══════════════════════════════════════════════════════╗${NC}"
        printf '\r\033[2K%s\n' "${GREEN}║                    More Tools                         ║${NC}"
        printf '\r\033[2K%s\n' "${GREEN}╚═══════════════════════════════════════════════════════╝${NC}"
        printf '\r\033[2K\n'

        # Menu options
        printf '\r\033[2K%s\n' "$(show_menu_option 1 "Swap Manager - Create/manage swap file" "$([[ $current_option -eq 1 ]] && echo true || echo false)")"
        printf '\r\033[2K%s\n' "$(show_menu_option 2 "Security - UFW firewall & Fail2Ban setup" "$([[ $current_option -eq 2 ]] && echo true || echo false)")"
        printf '\r\033[2K%s\n' "$(show_menu_option 3 "Startup Apps - Manage auto-start programs" "$([[ $current_option -eq 3 ]] && echo true || echo false)")"
        printf '\r\033[2K%s\n' "$(show_menu_option 4 "Nerd Fonts - Install patched developer fonts" "$([[ $current_option -eq 4 ]] && echo true || echo false)")"
        printf '\r\033[2K%s\n' "$(show_menu_option 5 "Back to Main Menu" "$([[ $current_option -eq 5 ]] && echo true || echo false)")"

        if [[ -t 0 ]]; then
            printf '\r\033[2K\n'
            printf '\r\033[2K%s\n' "${GRAY}↑/↓ Nav  ${GRAY}|${NC}  ${GRAY}Enter${NC} Select  ${GRAY}|${NC}  ${GRAY}Q${NC} Back"
            printf '\r\033[2K\n'
        fi

        # Clear any remaining content
        printf '\033[J'

        if [[ "$first_draw" == "true" ]]; then
            first_draw=false
        fi

        # Drain any pending input
        drain_pending_input

        local key
        if ! key=$(read_key); then
            continue
        fi

        case "$key" in
            "UP") ((current_option > 1)) && ((current_option--)) ;;
            "DOWN") ((current_option < 5)) && ((current_option++)) ;;
            "ENTER")
                show_cursor
                case $current_option in
                    1) exec "$SCRIPT_DIR/bin/swap.sh" ;;
                    2) exec "$SCRIPT_DIR/bin/security.sh" ;;
                    3) exec "$SCRIPT_DIR/bin/startup.sh" ;;
                    4) exec "$SCRIPT_DIR/bin/nerd-fonts.sh" ;;
                    5) exec "$0" ;; # Return to main menu
                esac
                ;;
            "CHAR:1")
                show_cursor
                exec "$SCRIPT_DIR/bin/swap.sh"
                ;;
            "CHAR:2")
                show_cursor
                exec "$SCRIPT_DIR/bin/security.sh"
                ;;
            "CHAR:3")
                show_cursor
                exec "$SCRIPT_DIR/bin/startup.sh"
                ;;
            "CHAR:4")
                show_cursor
                exec "$SCRIPT_DIR/bin/nerd-fonts.sh"
                ;;
            "CHAR:5")
                show_cursor
                exec "$0"
                ;;
            "QUIT")
                show_cursor
                exec "$0"
                ;;
        esac
    done
}

# Interactive main menu loop
interactive_main_menu() {
    # Show intro animation only once per terminal tab
    if [[ -t 1 ]]; then
        local tty_name
        tty_name=$(tty 2> /dev/null || echo "")
        if [[ -n "$tty_name" ]]; then
            local flag_file
            local cache_dir="$HOME/.cache/fub"
            mkdir -p "$cache_dir" 2> /dev/null
            flag_file="$cache_dir/intro_$(echo "$tty_name" | tr -c '[:alnum:]_' '_')"
            if [[ ! -f "$flag_file" ]]; then
                animate_fub_intro
                touch "$flag_file" 2> /dev/null || true
            fi
        fi
    fi
    local current_option=1
    local first_draw=true
    local brand_banner=""
    local msg_cache="$HOME/.cache/fub/update_message"
    local update_message=""

    brand_banner="$(show_brand_banner)"
    MAIN_MENU_BANNER="$brand_banner"

    if [[ -f "$msg_cache" && -s "$msg_cache" ]]; then
        update_message="$(cat "$msg_cache" 2> /dev/null || echo "")"
    fi
    MAIN_MENU_UPDATE_MESSAGE="$update_message"

    cleanup_and_exit() {
        show_cursor
        exit 0
    }

    trap cleanup_and_exit INT
    hide_cursor

    while true; do
        show_main_menu $current_option "$first_draw"
        if [[ "$first_draw" == "true" ]]; then
            first_draw=false
        fi

        # Drain any pending input to prevent touchpad scroll issues
        drain_pending_input

        local key
        if ! key=$(read_key); then
            continue
        fi

        case "$key" in
            "UP") ((current_option > 1)) && ((current_option--)) ;;
            "DOWN") ((current_option < 5)) && ((current_option++)) ;;
            "ENTER")
                show_cursor
                case $current_option in
                    1) exec "$SCRIPT_DIR/bin/status.sh" ;;
                    2) exec "$SCRIPT_DIR/bin/clean.sh" ;;
                    3) exec "$SCRIPT_DIR/bin/uninstall.sh" ;;
                    4) exec "$SCRIPT_DIR/bin/optimize.sh" ;;
                    5) show_more_tools_menu ;;
                esac
                ;;
            "CHAR:1")
                show_cursor
                exec "$SCRIPT_DIR/bin/status.sh"
                ;;
            "CHAR:2")
                show_cursor
                exec "$SCRIPT_DIR/bin/clean.sh"
                ;;
            "CHAR:3")
                show_cursor
                exec "$SCRIPT_DIR/bin/uninstall.sh"
                ;;
            "CHAR:4")
                show_cursor
                exec "$SCRIPT_DIR/bin/optimize.sh"
                ;;
            "CHAR:5")
                show_cursor
                show_more_tools_menu
                ;;
            "HELP")
                show_cursor
                clear
                show_help
                exit 0
                ;;
            "QUIT") cleanup_and_exit ;;
        esac
    done
}

