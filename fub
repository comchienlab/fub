            ;;
        "touchid")
            exec "$SCRIPT_DIR/bin/touchid.sh" "${@:2}"
            ;;
        "update")
            update_fub
            exit 0
            ;;
        "remove")
            remove_fub
            exit 0
            ;;
        "help" | "--help" | "-h")
            show_help
            exit 0
            ;;
        "version" | "--version" | "-V")
            show_version
            exit 0
            ;;
        "")
            check_for_updates
            interactive_main_menu
            ;;
        *)
            echo "Unknown command: $1"
            echo "Use 'fub --help' for usage information."
            exit 1
            ;;
    esac
}

main "$@"
