    "best_practices": [
      "Use XDG environment variables ($XDG_CACHE_HOME) with fallback to defaults",
      "Check all 4 package managers when detecting installed apps",
      "Always keep at least 2 most recent kernels",
      "Use journalctl --vacuum instead of manually deleting logs",
      "Respect XDG trash specification when deleting files",
      "Use systemctl for service management, not manual plist edits",
      "Test with snap's confined app model (different from flatpak)"
    ],

    "pitfalls": [
      "AppImage apps are just files, no package manager tracking",
      "Snap apps are confined, cache locations may vary",
      "Flatpak apps store data in ~/.var/app, not standard locations",
      "Some apps still use legacy ~/.appname instead of XDG dirs",
      "journalctl can use multiple GB if not configured properly",
      "Docker overlay storage can balloon quickly",
      "Old kernels in /boot can fill small boot partitions"
    ],

    "emerging_trends": [
      "Flatpak adoption increasing (sandboxed apps)",
