  "ubuntu_cleanup_locations": {
    "aggressive_mode_targets": [
      {
        "category": "Package Manager Caches",
        "paths": [
          "/var/cache/apt/archives",
          "/var/lib/snapd/cache",
          "~/.cache/snapd"
        ],
        "cleanup_cmd": "apt clean && apt autoclean",
        "risk": "low",
        "space_potential": "high"
      },
      {
        "category": "System Logs",
        "paths": [
          "/var/log/journal",
          "/var/log/*.log",
          "/var/log/*.gz"
        ],
        "cleanup_cmd": "journalctl --vacuum-time=7d --vacuum-size=100M",
        "risk": "low",
        "space_potential": "high",
        "notes": "Can free several GB"
      },
      {
        "category": "Old Kernels",
        "paths": [
          "/boot/vmlinuz-*",
          "/boot/initrd.img-*",
          "/lib/modules/*"
        ],
        "cleanup_cmd": "apt autoremove --purge",
        "risk": "medium",
        "space_potential": "medium",
        "notes": "Keep at least 2 most recent kernels"
      },
      {
        "category": "Orphaned Packages",
        "paths": [
          "N/A (metadata-based)"
        ],
        "cleanup_cmd": "apt autoremove && apt autopurge",
        "risk": "low",
        "space_potential": "medium"
      },
      {
        "category": "User Browser Caches",
        "paths": [
          "~/.cache/google-chrome",
          "~/.cache/chromium",
          "~/.cache/mozilla/firefox",
          "~/.cache/microsoft-edge"
        ],
        "cleanup_cmd": "rm -rf ~/.cache/google-chrome/* ~/.cache/chromium/*",
        "risk": "low",
        "space_potential": "high"
      },
      {
        "category": "Thumbnail Cache",
        "paths": [
          "~/.cache/thumbnails",
          "~/.thumbnails"
        ],
        "cleanup_cmd": "rm -rf ~/.cache/thumbnails/* ~/.thumbnails/*",
        "risk": "low",
        "space_potential": "medium"
      },
      {
        "category": "Temporary Files",
        "paths": [
          "/tmp/*",
          "/var/tmp/*",
          "~/.cache/tmp"
        ],
        "cleanup_cmd": "find /tmp -type f -atime +7 -delete (as root)",
        "risk": "low",
        "space_potential": "low",
        "notes": "Cleaned on reboot anyway"
      },
      {
        "category": "Trash",
        "paths": [
          "~/.local/share/Trash/files",
          "~/.local/share/Trash/info"
        ],
        "cleanup_cmd": "rm -rf ~/.local/share/Trash/files/* ~/.local/share/Trash/info/*",
        "risk": "low",
        "space_potential": "medium"
      },
      {
        "category": "User Application Caches",
        "paths": [
          "~/.cache/*"
        ],
        "cleanup_cmd": "find ~/.cache -type f -atime +30 -delete",
        "risk": "low",
        "space_potential": "high",
        "notes": "Most app caches, safe to delete"
      },
      {
        "category": "Snap-specific",
        "paths": [
          "~/snap/*/common/.cache",
          "/var/lib/snapd/snaps/*.snap (old revisions)"
        ],
        "cleanup_cmd": "snap set system refresh.retain=2",
        "risk": "low",
        "space_potential": "high",
        "notes": "Snap keeps multiple revisions by default"
      },
      {
        "category": "Flatpak caches",
        "paths": [
          "~/.var/app/*/cache",
          "/var/tmp/flatpak-cache-*"
        ],
        "cleanup_cmd": "flatpak uninstall --unused",
        "risk": "low",
        "space_potential": "medium"
      },
      {
        "category": "Developer Tools",
        "paths": [
          "~/.npm/_cacache",
          "~/.cargo/registry/cache",
          "~/.gradle/caches",
          "~/.m2/repository",
          "~/.cache/pip",
          "~/.cache/go-build",
          "~/.rustup/downloads"
        ],
        "cleanup_cmd": "npm cache clean --force && cargo cache --autoclean",
        "risk": "low",
        "space_potential": "very_high",
        "notes": "Similar to macOS, huge potential"
      },
      {
        "category": "Docker",
        "paths": [
          "/var/lib/docker/overlay2",
          "/var/lib/docker/volumes"
        ],
        "cleanup_cmd": "docker system prune -a --volumes",
        "risk": "medium",
        "space_potential": "very_high",
        "notes": "Can free dozens of GB"
      },
      {
        "category": "Wine prefixes",
        "paths": [
          "~/.wine/drive_c/users/*/Temp",
          "~/.wine/drive_c/windows/temp"
        ],
        "cleanup_cmd": "rm -rf ~/.wine/drive_c/users/*/Temp/*",
        "risk": "low",
        "space_potential": "medium"
      },
      {
        "category": "Recently Used Files",
        "paths": [
          "~/.local/share/recently-used.xbel"
        ],
        "cleanup_cmd": "rm ~/.local/share/recently-used.xbel",
        "risk": "low",
        "space_potential": "low"
      },
      {
        "category": "Core Dumps",
        "paths": [
          "/var/crash/*",
          "/var/lib/systemd/coredump/*"
        ],
        "cleanup_cmd": "rm -rf /var/crash/* /var/lib/systemd/coredump/*",
        "risk": "low",
        "space_potential": "medium"
      }
    ]
  },

