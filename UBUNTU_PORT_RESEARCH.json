      ],
      "ubuntu": [
        {
          "name": "APT/DPKG",
          "type": "native",
          "install_cmd": "apt install",
          "uninstall_cmd": "apt remove / apt purge",
          "list_cmd": "apt list --installed / dpkg -l",
          "locations": ["/usr/bin", "/usr/lib", "/usr/share", "/etc"],
          "data_dirs": ["/var/lib/dpkg", "/var/cache/apt"],
          "priority": 1,
          "notes": "System package manager, most integrated"
        },
        {
          "name": "Snap",
          "type": "containerized",
          "install_cmd": "snap install",
          "uninstall_cmd": "snap remove",
          "list_cmd": "snap list",
          "locations": ["/snap", "~/snap"],
          "data_dirs": ["/var/lib/snapd", "/var/snap", "~/snap"],
          "priority": 2,
          "notes": "Canonical's universal package format, auto-updates, includes dependencies"
        },
        {
          "name": "Flatpak",
          "type": "containerized",
          "install_cmd": "flatpak install",
          "uninstall_cmd": "flatpak uninstall",
          "list_cmd": "flatpak list",
          "locations": ["/var/lib/flatpak", "~/.local/share/flatpak"],
          "data_dirs": ["/var/lib/flatpak", "~/.var/app"],
          "priority": 3,
          "notes": "Sandboxed apps, Flathub repository, cross-distro"
        },
        {
          "name": "AppImage",
          "type": "portable",
          "install_cmd": "chmod +x file.AppImage",
          "uninstall_cmd": "rm file.AppImage",
          "list_cmd": "find ~ -name '*.AppImage'",
          "locations": ["~/Applications", "~/Downloads", "~/.local/bin"],
          "data_dirs": ["~/.config", "~/.local/share"],
          "priority": 4,
          "notes": "Self-contained executables, no install, manual desktop integration"
        }
      ]
    },

